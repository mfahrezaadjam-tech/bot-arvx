// Fungsi memuat & menyimpan blacklist permanen
function loadBlacklist() {
    try {
        if (!fs.existsSync('blacklist.json')) fs.writeFileSync('blacklist.json', '[]');
        const data = fs.readFileSync('blacklist.json', 'utf-8');
        return new Set(JSON.parse(data));
    } catch (e) { return new Set(); }
}

function saveBlacklist(set) {
    fs.writeFileSync('blacklist.json', JSON.stringify(Array.from(set), null, 2));
}

